# Copy to `.env.local` and fill in. `.env.local` is git-ignored.

# Server-only Cloudflare Radar API token. Never prefixed with NEXT_PUBLIC_,
# never sent to the browser. Create one in the Cloudflare dashboard under
# My Profile > API Tokens with the "Cloudflare Radar: Read" permission.
CLOUDFLARE_RADAR_API_TOKEN=

# Explicit demo mode for local development. When "true" the API route serves
# deterministic sample corridors and the UI shows a permanent DEMO banner.
# Never enable this in a deployment that is meant to show live telemetry.
RADAR_DEMO_MODE=false

# Client-visible companion flag. When "true" the dashboard renders sample data
# locally without calling the API route at all (still labelled DEMO).
NEXT_PUBLIC_RADAR_DEMO_MODE=false

# Optional client refresh cadence in milliseconds (default 60000, minimum
# 30000). This is a display cadence only: Cloudflare Radar publishes aggregate
# datasets on its own schedule, so frequent polling does not create fresher data.
NEXT_PUBLIC_RADAR_REFRESH_INTERVAL_MS=60000
